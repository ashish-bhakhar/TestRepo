@model IEnumerable<RecruitmentApp.Models.JobPosting>
@{
    ViewData["Title"] = "Job Postings";
}

<div class="page-toolbar">
    <form method="get" class="search-form">
        <div class="search-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="text" name="search" value="@ViewBag.CurrentSearch" placeholder="Search jobs..." class="search-input" />
        </div>
        <div class="filter-tabs">
            <a href="?status=&search=@ViewBag.CurrentSearch" class="filter-tab @(ViewBag.CurrentStatus == null || ViewBag.CurrentStatus == "" ? "active" : "")">All</a>
            <a href="?status=Open&search=@ViewBag.CurrentSearch" class="filter-tab @(ViewBag.CurrentStatus == "Open" ? "active" : "")">Open</a>
            <a href="?status=Closed&search=@ViewBag.CurrentSearch" class="filter-tab @(ViewBag.CurrentStatus == "Closed" ? "active" : "")">Closed</a>
        </div>
    </form>
    <a asp-action="Create" class="btn-primary">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="14" height="14"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        New Job
    </a>
</div>

<div class="table-card">
    <table class="data-table">
        <thead>
            <tr>
                <th>Job Title</th>
                <th>Department</th>
                <th>Location</th>
                <th>Type</th>
                <th>Applications</th>
                <th>Status</th>
                <th>Posted</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var job in Model)
            {
                <tr>
                    <td>
                        <a asp-action="Details" asp-route-id="@job.Id" class="table-link">@job.Title</a>
                    </td>
                    <td><span class="tag">@job.Department</span></td>
                    <td class="text-muted">@job.Location</td>
                    <td class="text-muted">@job.EmploymentType</td>
                    <td>
                        <span class="app-count">@job.Applications.Count</span>
                    </td>
                    <td><span class="badge badge-@job.Status.ToLower()">@job.Status</span></td>
                    <td class="text-muted">@job.PostedDate.ToString("MMM d, yyyy")</td>
                    <td>
                        <div class="action-group">
                            <a asp-action="Edit" asp-route-id="@job.Id" class="btn-action">Edit</a>
                            <form asp-action="Delete" method="post" style="display:inline" onsubmit="return confirm('Delete this job posting?')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@job.Id" />
                                <button type="submit" class="btn-action danger">Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="8" class="empty-row">No job postings found.</td></tr>
            }
        </tbody>
    </table>
</div>
