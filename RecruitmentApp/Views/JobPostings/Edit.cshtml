@model RecruitmentApp.Models.JobPosting
@{
    ViewData["Title"] = "Edit Job Posting";
}

<div class="form-page">
    <div class="form-card">
        <div class="form-card-header">
            <h2>Edit Job Posting</h2>
            <a asp-action="Index" class="btn-ghost">← Back to Jobs</a>
        </div>
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="PostedDate" />
            <div class="form-grid">
                <div class="form-group full">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="field-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Department" class="form-label"></label>
                    <input asp-for="Department" class="form-control" />
                    <span asp-validation-for="Department" class="field-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Location" class="form-label"></label>
                    <input asp-for="Location" class="form-control" />
                    <span asp-validation-for="Location" class="field-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="EmploymentType" class="form-label"></label>
                    <select asp-for="EmploymentType" class="form-control">
                        <option>Full-Time</option><option>Part-Time</option><option>Contract</option><option>Internship</option><option>Remote</option>
                    </select>
                </div>
                <div class="form-group">
                    <label asp-for="SalaryRange" class="form-label"></label>
                    <input asp-for="SalaryRange" class="form-control" />
                </div>
                <div class="form-group">
                    <label asp-for="ClosingDate" class="form-label"></label>
                    <input asp-for="ClosingDate" type="date" class="form-control" />
                </div>
                <div class="form-group">
                    <label asp-for="Status" class="form-label"></label>
                    <select asp-for="Status" class="form-control">
                        <option>Open</option><option>Closed</option><option>Draft</option>
                    </select>
                </div>
                <div class="form-group full">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                    <span asp-validation-for="Description" class="field-error"></span>
                </div>
                <div class="form-group full">
                    <label asp-for="Requirements" class="form-label"></label>
                    <textarea asp-for="Requirements" class="form-control" rows="5"></textarea>
                    <span asp-validation-for="Requirements" class="field-error"></span>
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn-primary">Save Changes</button>
                <a asp-action="Index" class="btn-ghost">Cancel</a>
            </div>
        </form>
    </div>
</div>
