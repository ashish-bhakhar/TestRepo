@{
    ViewData["Title"] = "Dashboard";
}

<div class="dashboard">
    <!-- Stat Cards -->
    <div class="stats-grid">
        <div class="stat-card accent">
            <div class="stat-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            </div>
            <div class="stat-body">
                <div class="stat-value">@ViewBag.OpenJobs</div>
                <div class="stat-label">Open Positions</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
            </div>
            <div class="stat-body">
                <div class="stat-value">@ViewBag.TotalCandidates</div>
                <div class="stat-label">Total Candidates</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
            </div>
            <div class="stat-body">
                <div class="stat-value">@ViewBag.TotalApplications</div>
                <div class="stat-label">Applications</div>
            </div>
        </div>
        <div class="stat-card gold">
            <div class="stat-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            </div>
            <div class="stat-body">
                <div class="stat-value">@ViewBag.InterviewsScheduled</div>
                <div class="stat-label">Interviews Scheduled</div>
            </div>
        </div>
    </div>

    <!-- Lower Grid -->
    <div class="dashboard-grid">
        <!-- Recent Applications -->
        <div class="dash-panel">
            <div class="panel-header">
                <h2 class="panel-title">Recent Applications</h2>
                <a asp-controller="Applications" asp-action="Index" class="panel-link">View all</a>
            </div>
            <div class="app-list">
                @foreach (var app in ViewBag.RecentApplications)
                {
                    <div class="app-row">
                        <div class="app-avatar">@app.Candidate.FirstName[0]@app.Candidate.LastName[0]</div>
                        <div class="app-info">
                            <div class="app-name">@app.Candidate.FullName</div>
                            <div class="app-job">@app.JobPosting.Title</div>
                        </div>
                        <div class="app-meta">
                            <span class="badge badge-@app.Status.ToLower().Replace(" ", "-")">@app.Status</span>
                            <div class="app-date">@app.AppliedDate.ToString("MMM d")</div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Recent Jobs -->
        <div class="dash-panel">
            <div class="panel-header">
                <h2 class="panel-title">Active Job Postings</h2>
                <a asp-controller="JobPostings" asp-action="Create" class="panel-link">+ Add Job</a>
            </div>
            <div class="job-list">
                @foreach (var job in ViewBag.RecentJobs)
                {
                    <a asp-controller="JobPostings" asp-action="Details" asp-route-id="@job.Id" class="job-row">
                        <div class="job-info">
                            <div class="job-title">@job.Title</div>
                            <div class="job-meta-row">
                                <span class="job-dept">@job.Department</span>
                                <span class="job-loc">@job.Location</span>
                            </div>
                        </div>
                        <div class="job-right">
                            <span class="badge badge-@job.Status.ToLower()">@job.Status</span>
                            <div class="job-apps">@job.Applications.Count apps</div>
                        </div>
                    </a>
                }
            </div>
        </div>
    </div>
</div>
