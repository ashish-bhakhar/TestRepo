@model RecruitmentApp.Models.Candidate
@{
    ViewData["Title"] = "Edit Candidate";
}

<div class="form-page">
    <div class="form-card">
        <div class="form-card-header">
            <h2>Edit Candidate</h2>
            <a asp-action="Index" class="btn-ghost">← Back to Candidates</a>
        </div>

        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="RegisteredDate" />
            <div class="form-grid">
                <div class="form-group">
                    <label asp-for="FirstName" class="form-label"></label>
                    <input asp-for="FirstName" class="form-control" />
                    <span asp-validation-for="FirstName" class="field-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="LastName" class="form-label"></label>
                    <input asp-for="LastName" class="form-control" />
                    <span asp-validation-for="LastName" class="field-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" type="email" class="form-control" />
                    <span asp-validation-for="Email" class="field-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Phone" class="form-label"></label>
                    <input asp-for="Phone" class="form-control" />
                </div>
                <div class="form-group">
                    <label asp-for="CurrentTitle" class="form-label"></label>
                    <input asp-for="CurrentTitle" class="form-control" />
                </div>
                <div class="form-group">
                    <label asp-for="YearsOfExperience" class="form-label"></label>
                    <input asp-for="YearsOfExperience" type="number" class="form-control" />
                </div>
                <div class="form-group full">
                    <label asp-for="Skills" class="form-label"></label>
                    <input asp-for="Skills" class="form-control" />
                </div>
                <div class="form-group">
                    <label asp-for="LinkedInUrl" class="form-label"></label>
                    <input asp-for="LinkedInUrl" class="form-control" />
                </div>
                <div class="form-group">
                    <label asp-for="ResumeUrl" class="form-label"></label>
                    <input asp-for="ResumeUrl" class="form-control" />
                </div>
                
                <!-- Current Resume Display & Upload -->
                <div class="form-group full">
                    <label class="form-label">Resume/CV File</label>
                    
                    @if (Model.HasUploadedResume)
                    {
                        <div class="current-resume-display">
                            <div class="resume-file-info">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                    <polyline points="14 2 14 8 20 8"/>
                                </svg>
                                <span class="resume-name">@Model.ResumeFileName</span>
                                <a asp-action="DownloadResume" asp-route-id="@Model.Id" class="btn-action">
                                    Download
                                </a>
                            </div>
                            <label class="delete-resume-checkbox">
                                <input type="checkbox" name="deleteResume" value="true" />
                                <span>Delete this resume</span>
                            </label>
                        </div>
                    }
                    
                    <div class="file-upload-wrapper" style="margin-top: @(Model.HasUploadedResume ? "16px" : "0")">
                        <div class="file-upload-area">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="24" height="24">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                <polyline points="14 2 14 8 20 8"/>
                            </svg>
                            <label for="resumeFile" class="file-upload-label">
                                @(Model.HasUploadedResume ? "Upload new resume to replace" : "Click to upload or drag and drop")
                            </label>
                            <p class="file-upload-hint">PDF, DOC, DOCX (max 5MB)</p>
                            <input type="file" id="resumeFile" name="resumeFile" accept=".pdf,.doc,.docx" class="file-input-hidden" />
                        </div>
                        <div class="file-selected-name"></div>
                    </div>
                </div>

                <div class="form-group full">
                    <label asp-for="Notes" class="form-label"></label>
                    <textarea asp-for="Notes" class="form-control" rows="4"></textarea>
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn-primary">Save Changes</button>
                <a asp-action="Index" class="btn-ghost">Cancel</a>
            </div>
        </form>
    </div>
</div>

<script>
    const fileInput = document.getElementById('resumeFile');
    const fileSelectedName = document.querySelector('.file-selected-name');
    const uploadArea = document.querySelector('.file-upload-area');
    const deleteCheckbox = document.querySelector('input[name="deleteResume"]');
    
    fileInput.addEventListener('change', function() {
        if (this.files && this.files[0]) {
            const fileName = this.files[0].name;
            const fileSize = (this.files[0].size / 1024).toFixed(1);
            fileSelectedName.innerHTML = `<strong>Selected:</strong> ${fileName} (${fileSize} KB)`;
            fileSelectedName.style.display = 'block';
            
            // Uncheck delete if uploading new file
            if (deleteCheckbox) {
                deleteCheckbox.checked = false;
            }
        } else {
            fileSelectedName.style.display = 'none';
        }
    });
    
    // Uncheck delete when selecting new file
    if (deleteCheckbox) {
        fileInput.addEventListener('click', function() {
            deleteCheckbox.checked = false;
        });
    }
    
    // Drag and drop
    ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
        uploadArea.addEventListener(eventName', preventDefaults, false);
    });
    
    function preventDefaults(e) {
        e.preventDefault();
        e.stopPropagation();
    }
    
    ['dragenter', 'dragover'].forEach(eventName => {
        uploadArea.addEventListener(eventName, () => {
            uploadArea.style.borderColor = 'var(--gold)';
            uploadArea.style.background = 'var(--gold-dim)';
        });
    });
    
    ['dragleave', 'drop'].forEach(eventName => {
        uploadArea.addEventListener(eventName, () => {
            uploadArea.style.borderColor = '';
            uploadArea.style.background = '';
        });
    });
    
    uploadArea.addEventListener('drop', (e) => {
        const dt = e.dataTransfer;
        const files = dt.files;
        fileInput.files = files;
        
        const event = new Event('change', { bubbles: true });
        fileInput.dispatchEvent(event);
    });
</script>
