@model IEnumerable<RecruitmentApp.Models.Candidate>
@{
    ViewData["Title"] = "Candidates";
}

<div class="page-toolbar">
    <form method="get" class="search-form">
        <div class="search-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="text" name="search" value="@ViewBag.CurrentSearch" placeholder="Search candidates..." class="search-input" />
        </div>
    </form>
    <a asp-action="Create" class="btn-primary">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="14" height="14"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Add Candidate
    </a>
</div>

<div class="cards-grid">
    @foreach (var candidate in Model)
    {
        <div class="candidate-card">
            <div class="candidate-top">
                <div class="candidate-avatar">@candidate.FirstName[0]@candidate.LastName[0]</div>
                <div class="candidate-info">
                    <a asp-action="Details" asp-route-id="@candidate.Id" class="candidate-name">@candidate.FullName</a>
                    <div class="candidate-title">@(candidate.CurrentTitle ?? "Candidate")</div>
                </div>
            </div>

            <div class="candidate-details">
                <div class="cand-detail-row">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                    <span>@candidate.Email</span>
                </div>
                @if (!string.IsNullOrEmpty(candidate.Phone))
                {
                    <div class="cand-detail-row">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.77 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 17.92z"/></svg>
                        <span>@candidate.Phone</span>
                    </div>
                }
                <div class="cand-detail-row">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    <span>@candidate.YearsOfExperience yrs experience</span>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(candidate.Skills))
            {
                <div class="skills-wrap">
                    @foreach (var skill in candidate.Skills.Split(',').Take(4))
                    {
                        <span class="skill-tag">@skill.Trim()</span>
                    }
                </div>
            }

            <div class="candidate-footer">
                <span class="apps-count">@candidate.Applications.Count application(s)</span>
                <div class="action-group">
                    <a asp-action="Edit" asp-route-id="@candidate.Id" class="btn-action">Edit</a>
                    <form asp-action="Delete" method="post" style="display:inline" onsubmit="return confirm('Remove this candidate?')">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@candidate.Id" />
                        <button type="submit" class="btn-action danger">Remove</button>
                    </form>
                </div>
            </div>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="empty-state">
            <p>No candidates found. <a asp-action="Create">Add the first candidate.</a></p>
        </div>
    }
</div>
